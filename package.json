{
  "name": "lem-box-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint src next.config.ts postcss.config.mjs eslint.config.mjs scripts",
    "lint:ci": "eslint src next.config.ts postcss.config.mjs eslint.config.mjs scripts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "verify:seo": "node scripts/verify-seo.mjs",
    "verify:build": "node scripts/verify-build-output.mjs",
    "to-webp-all": "find public -type f \\( -name '*.jpg' -o -name '*.jpeg' -o -name '*.png' \\) -exec sh -c 'cwebp -q 82 \"$0\" -o \"${0%.*}.webp\"' {} \\;"
  },
  "dependencies": {
    "lucide-react": "^0.542.0",
    "next": "15.5.23",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "react-icons": "^5.5.0",
    "resend": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.2"
  }
}
